{
  "name": "reading-improving",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian 本地优先阅读学习插件：EPUB 转 Markdown、可回链阅读记录与知识沉淀。",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && node esbuild.config.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
